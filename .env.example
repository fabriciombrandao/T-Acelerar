# Copie para .env DENTRO de cada checkout de ambiente (ver README —
# /opt/tacelerar/{prod,dev,teste}/, um checkout git por ambiente,
# cada um com seu próprio .env). Nunca commitar o .env real.

ENVIRONMENT=prod
# ^ ajuste para "dev" ou "teste" no arquivo daquele ambiente. Informativo
# por enquanto (não consumido pelo código ainda), mantido por paridade
# com o padrão de nomenclatura do time.

# --- Banco de dados ---
# POSTGRES_* alimenta o container do Postgres. TACELERAR_DB_URL alimenta
# o backend/worker. São a MESMA credencial escrita duas vezes de propósito
# — env_file não faz interpolação de variável dentro de si mesmo, então
# não dá pra montar TACELERAR_DB_URL a partir de ${POSTGRES_PASSWORD} aqui.
# Trocar a senha = trocar nos dois lugares.
POSTGRES_DB=tacelerar_prod
POSTGRES_USER=tacelerar
POSTGRES_PASSWORD=troque-por-uma-senha-forte
TACELERAR_DB_URL=postgresql+psycopg2://tacelerar:troque-por-uma-senha-forte@db:5432/tacelerar_prod

# --- Redis (broker do Celery) ---
TACELERAR_REDIS_URL=redis://redis:6379/0

# --- Autenticação ---
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
TACELERAR_JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Secret temporário só para criar o primeiro DIRETOR via
# POST /api/auth/bootstrap-admin. Depois que o primeiro usuário existir,
# o endpoint já se bloqueia sozinho independente deste valor continuar aqui.
TACELERAR_BOOTSTRAP_SECRET=troque-por-outro-valor-aleatorio
