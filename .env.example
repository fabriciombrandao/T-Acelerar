# Copie para .env e ajuste. Nunca commitar o .env real.

# SQLite local (default, dev com 1 pessoa só):
WINTHOR_DB_URL=sqlite:///./winthor_data_deploy.db

# Postgres (OBRIGATÓRIO a partir de 2+ consultores simultâneos — SQLite trava
# com escrita concorrente):
# WINTHOR_DB_URL=postgresql+psycopg2://usuario:senha@host:5432/winthor_data_deploy

# Autenticação — OBRIGATÓRIOS em qualquer ambiente compartilhado (VPS).
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
WINTHOR_JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Secret temporário só para criar o primeiro admin via POST /auth/bootstrap-admin.
# Depois que o primeiro admin existir, pode remover — o endpoint já bloqueia
# sozinho (só funciona uma vez, enquanto não houver nenhum usuário).
WINTHOR_BOOTSTRAP_SECRET=troque-por-outro-valor-aleatorio

# Porta/host da aplicação (usado pelo docker-compose e systemd unit)
# Confira antes se a porta já não está em uso por outra aplicação no VPS:
#   sudo ss -tlnp | grep LISTEN
APP_HOST=0.0.0.0
APP_PORT=8420

# ---------------------------------------------------------------------
# Limites de recurso — AJUSTE conforme a capacidade real do VPS antes de
# subir. Este VPS roda outra aplicação de produção (TNORTEANDO); os
# valores abaixo existem para nunca sufocar recurso do vizinho durante um
# import grande. Ver README.md, seção "Ambiente compartilhado", para como
# medir a capacidade disponível antes de escolher os números.
# ---------------------------------------------------------------------
APP_MEM_LIMIT=512m
APP_CPU_LIMIT=1.0
WORKER_MEM_LIMIT=1g
WORKER_CPU_LIMIT=1.5
WORKER_CONCURRENCY=2
DB_MEM_LIMIT=512m
DB_CPU_LIMIT=1.0
